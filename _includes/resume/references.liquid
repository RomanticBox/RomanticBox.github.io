<div class="list-groups">
  {% for content in data[1] %}
    <div class="list-group col-md-6">
      <table class="table-cv list-group-table">
        <tbody>
          <tr>
            {% if content.icon %}
              <td class="list-group-category-icon">
                <i class="{{ content.icon }}"></i>
              </td>
            {% else %}
              <td class="list-group-category-icon"></td>
            {% endif %}
            <!-- Calculate colspan number for category title -->
            {% assign i = 1 %}
            {% for item in content.items %}
              {% assign i = i | plus: 1 %}
            {% endfor %}
            <td colspan="{{ i }}" class="list-group-category">{{ content.name }}</td>
          </tr>
          <tr>
            <td></td>
            <td class="list-group-name">
              {% if content.reference %}
                <a href="{{ content.reference }}" target="_blank" rel="noopener noreferrer"
                  ><b>{{ content.reference }}</b></a
                >
              {% endif %}
            </td>
          </tr>
          {% if content.summary %}
            <tr>
              <td></td>
              <td class="list-group-name" style="font-style: italic; font-weight: normal">{{ content.summary }}</td>
            </tr>
          {% endif %}
        </tbody>
      </table>
    </div>
  {% endfor %}
</div>
